{
	"name": "github-discord-notification",
	"type": "module",
	"private": true,
	"scripts": {
		"update": "bun update wrangler",
		"types": "bun run update && wrangler types",
		"dev": "bun run types && wrangler dev",
		"remote": "bun run types && wrangler dev --remote",
		"deploy": "bun run types && wrangler deploy",
		"tail": "bun run update && wrangler tail",
		"bundle": "bun run deploy --dry-run --outdir ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"typescript": "^7.0.2",
		"wrangler": "^4.131.1"
	}
}
